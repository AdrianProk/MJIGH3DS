# Originaldaten des Spiels: urheberrechtlich geschützt und zu groß für GitHub.
# Niemals committen oder pushen.
original/
game/
game-en/
*.iso
*.zip

# Dekompilierter Lingo-Code und Dumps (vom Original abgeleitet, nur lokal)
analysis/

# ScummVM-Arbeitskopie (eigene Änderungen liegen als Patches in patches/)
scummvm/

# Build-Ausgaben (enthalten das Spiel; Sicherung als privates GitHub-Release, docs/build-3ds.md)
dist/
*.smdh
*.elf

# Python
__pycache__/
*.pyc

# Fremdwerkzeuge (z. B. ProjectorRays-Binary), lokal heruntergeladen
vendor/

# Absturz-Logs und -Berichte vom 3DS (lokal, nicht ins Repo)
crashfiles/
