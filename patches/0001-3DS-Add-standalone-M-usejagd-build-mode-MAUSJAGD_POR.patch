+#ifndef BACKENDS_PLATFORM_3DS_MAUSJAGD_H
+#define BACKENDS_PLATFORM_3DS_MAUSJAGD_H
+
+// Settings for the standalone "Mäusejagd im Grandhotel" 3DS build.
+// Only used when MAUSJAGD_PORT is defined. The app keeps its config,
+// log, saves and game data in its own folder, so it can live next to
+// a regular ScummVM installation, and starts the game without the launcher.
+
+#ifndef MAUSJAGD_APP_DIR
+#define MAUSJAGD_APP_DIR "sdmc:/3ds/mausjagd/"
+#endif
+
+#ifndef MAUSJAGD_GAME_DIR
+#define MAUSJAGD_GAME_DIR MAUSJAGD_APP_DIR "game"
+#endif
+
+#ifndef MAUSJAGD_GAME_ID
+#define MAUSJAGD_GAME_ID "director:ggmd"
+#endif
+
+#endif
diff --git a/backends/platform/3ds/osystem.cpp b/backends/platform/3ds/osystem.cpp
index d2b7ec84e6..524bedb147 100644
--- a/backends/platform/3ds/osystem.cpp
+++ b/backends/platform/3ds/osystem.cpp
@@ -37,6 +37,9 @@
 
 #include "backends/fs/posix-drives/posix-drives-fs-factory.h"
 #include "backends/fs/posix-drives/posix-drives-fs.h"
+#ifdef MAUSJAGD_PORT
+#include "backends/platform/3ds/mausjagd.h"
+#endif
 #include <unistd.h>
 #include <time.h>
 
@@ -152,7 +155,11 @@ void OSystem_3DS::initBackend() {
 
 	_eventManager = new DefaultEventManager(this);
 	_timerManager = new DefaultTimerManager();
+#ifdef MAUSJAGD_PORT
+	_savefileManager = new DefaultSaveFileManager(MAUSJAGD_APP_DIR "saves/");
+#else
 	_savefileManager = new DefaultSaveFileManager("sdmc:/3ds/scummvm/saves/");
+#endif
 
 	init3DSGraphics();
 	initAudio();
@@ -185,11 +192,19 @@ void OSystem_3DS::updateConfig() {
 }
 
 Common::Path OSystem_3DS::getDefaultConfigFileName() {
+#ifdef MAUSJAGD_PORT
+	return MAUSJAGD_APP_DIR "scummvm.ini";
+#else
 	return "sdmc:/3ds/scummvm/scummvm.ini";
+#endif
 }
 
 Common::Path OSystem_3DS::getDefaultLogFileName() {
+#ifdef MAUSJAGD_PORT
+	return MAUSJAGD_APP_DIR "scummvm.log";
+#else
 	return "sdmc:/3ds/scummvm/scummvm.log";
+#endif
 }
 
 void OSystem_3DS::addSysArchivesToSearchSet(Common::SearchSet &s, int priority) {
diff --git a/engines/dialogs.cpp b/engines/dialogs.cpp
index 28690bd02a..6f8ad94c3b 100644
--- a/engines/dialogs.cpp
+++ b/engines/dialogs.cpp
@@ -89,6 +89,10 @@ MainMenuDialog::MainMenuDialog(Engine *engine)
 	else
 		_returnToLauncherButton = new GUI::ButtonWidget(this, "GlobalMenu.ReturnToLauncher", _c("~R~eturn to Launcher", "lowres"), Common::U32String(), kLauncherCmd);
 	_returnToLauncherButton->setEnabled(_engine->hasFeature(Engine::kSupportsReturnToLauncher));
+#ifdef MAUSJAGD_PORT
+	// Standalone game build: there is no launcher to return to
+	_returnToLauncherButton->setEnabled(false);
+#endif
 
 	if (!g_system->hasFeature(OSystem::kFeatureNoQuit) && (!(ConfMan.getBool("gui_return_to_launcher_at_exit")) || !_engine->hasFeature(Engine::kSupportsReturnToLauncher)))
 		new GUI::ButtonWidget(this, "GlobalMenu.Quit", _("~Q~uit"), Common::U32String(), kQuitCmd);
