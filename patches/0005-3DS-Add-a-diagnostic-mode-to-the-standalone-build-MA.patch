 #include "common/rect.h"
 #include "graphics/blit.h"
 #include "graphics/fontman.h"
@@ -188,6 +191,9 @@ bool OSystem_3DS::setGraphicsMode(GraphicsModeID modeID) {
 void OSystem_3DS::initSize(uint width, uint height,
 						   const Graphics::PixelFormat *format) {
 	debug("3ds initsize w:%d h:%d", width, height);
+#ifdef MAUSJAGD_PORT
+	Mausjagd::diagResolutionChanged(width, height);
+#endif
 	updateBacklight();
 	updateConfig();
 
@@ -438,11 +444,27 @@ void OSystem_3DS::updateScreen() {
 		return;
 	}
 
+#ifdef MAUSJAGD_PORT
+	// Diagnostic mode: area converted for the GPU and time spent
+	const bool diag = Mausjagd::diagEnabled();
+	const u64 diagStart = diag ? svcGetSystemTick() : 0;
+	uint32 diagDirtyPixels = 0;
+	if (diag && _pfGame != _gameTopTexture.format) {
+		_dirtyRects.merge();
+		for (const Common::Rect &r : _dirtyRects)
+			diagDirtyPixels += r.width() * r.height();
+	}
+#endif
+
 	if (!_dirtyRects.empty()) {
 		flushGameScreen();
 		_dirtyRects.clear();
 	}
 
+#ifdef MAUSJAGD_PORT
+	const u64 diagFlushTicks = diag ? svcGetSystemTick() - diagStart : 0;
+#endif
+
 // 	updateFocus();
 	updateMagnify();
 
@@ -521,6 +543,11 @@ void OSystem_3DS::updateScreen() {
 			}
 		}
 	C3D_FrameEnd(0);
+
+#ifdef MAUSJAGD_PORT
+	if (diag)
+		Mausjagd::diagFrame(diagDirtyPixels, diagFlushTicks, svcGetSystemTick() - diagStart);
+#endif
 }
 
