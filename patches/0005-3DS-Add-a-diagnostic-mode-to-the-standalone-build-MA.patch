 void OSystem_3DS::updateBacklight() {
@@ -266,8 +276,20 @@ void OSystem_3DS::logMessage(LogMessageType::Type type, const char *message) {
 	printf("%s", message);
 
 	// Then log into file (via the logger)
-	if (_logger)
+	if (_logger) {
+#ifdef MAUSJAGD_PORT
+		// Diagnostic mode: prefix each line with the time since app start in seconds
+		static bool lineStart = true;
+		if (Mausjagd::diagEnabled() && *message) {
+			if (lineStart) {
+				const uint32 ms = Mausjagd::millisSinceStart();
+				_logger->print(Common::String::format("[+%u.%03u] ", ms / 1000, ms % 1000).c_str());
+			}
+			lineStart = message[strlen(message) - 1] == '\n';
+		}
+#endif
 		_logger->print(message);
+	}
 }
 
