diff --git a/backends/platform/3ds/mausjagd.cpp b/backends/platform/3ds/mausjagd.cpp
new file mode 100644
index 0000000000..0f6a23b3ad
--- /dev/null
+++ b/backends/platform/3ds/mausjagd.cpp
@@ -0,0 +1,181 @@
+/* ScummVM - Graphic Adventure Engine
+ *
+ * ScummVM is the legal property of its developers, whose names
+ * are too numerous to list here. Please refer to the COPYRIGHT
+ * file distributed with this source distribution.
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation, either version 3 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <http://www.gnu.org/licenses/>.
+ *
+ */
+
+// Diagnostic mode of the standalone "Mäusejagd im Grandhotel" 3DS build,
+// see mausjagd.h. Only compiled when MAUSJAGD_PORT is defined.
+
+#ifdef MAUSJAGD_PORT
+
+#define FORBIDDEN_SYMBOL_EXCEPTION_time_h
+
+#include <3ds.h>
+
+#include "backends/platform/3ds/mausjagd.h"
+#include "common/debug.h"
+#include "common/fs.h"
+#include "common/stream.h"
+#include "common/tokenizer.h"
+
+namespace Mausjagd {
+
+static uint64 appStartTick = 0;
+static bool diagOn = false;
+static Common::StringArray diagOptions;
+
+// First frame after a resolution change
+static bool firstFramePending = false;
+static uint firstFrameWidth = 0;
+static uint firstFrameHeight = 0;
+static uint32 resolutionChangeTime = 0;
+
+// Frame statistics of the current interval
+static bool statsRunning = false;
+static uint32 statsStart = 0;
+static uint32 statsFrames = 0;
+static uint64 statsDirtyPixels = 0;
+static uint64 statsFlushTicks = 0;
+static uint64 statsFlushMax = 0;
+static uint64 statsUpdateTicks = 0;
+static uint64 statsUpdateMax = 0;
+
+// The system tick runs at the ARM11 base clock on Old and New 3DS
+static uint32 ticksToMicros(uint64 ticks) {
+	return (uint32)(ticks * 1000000 / SYSCLOCK_ARM11);
+}
+
+void markAppStart() {
+	appStartTick = svcGetSystemTick();
+}
+
+uint32 millisSinceStart() {
+	return (uint32)((svcGetSystemTick() - appStartTick) * 1000 / SYSCLOCK_ARM11);
+}
+
+static void addOptions(const Common::String &text) {
+	Common::StringTokenizer tokens(text);
+	while (!tokens.empty()) {
+		Common::String token = tokens.nextToken();
+		if (!token.empty())
+			diagOptions.push_back(token);
+	}
+}
+
+static bool readDiagFile(const char *location) {
+	Common::FSNode node(Common::Path(location, '/'));
+	if (!node.exists() || node.isDirectory())
+		return false;
+
+	Common::SeekableReadStream *stream = node.createReadStream();
+	if (stream) {
+		while (!stream->eos() && !stream->err()) {
+			Common::String line = stream->readLine();
+			line.trim();
+			if (!line.empty() && line.firstChar() != '#')
+				addOptions(line);
+		}
+		delete stream;
+	}
+	return true;
+}
+
+void initDiag() {
+	diagOn = readDiagFile(MAUSJAGD_APP_DIR MAUSJAGD_DIAG_FILE) ||
+	         readDiagFile("romfs:/" MAUSJAGD_DIAG_FILE);
+	if (diagOn && diagOptions.empty())
+		addOptions(MAUSJAGD_DIAG_DEFAULT_ARGS);
+}
+
+bool diagEnabled() {
+	return diagOn;
+}
+
+const Common::StringArray &diagArgs() {
+	return diagOptions;
+}
+
+void diagResolutionChanged(uint width, uint height) {
+	if (!diagOn)
+		return;
+
+	firstFramePending = true;
+	firstFrameWidth = width;
+	firstFrameHeight = height;
+	resolutionChangeTime = millisSinceStart();
+}
+
+// Formats microseconds as milliseconds with one decimal
+static Common::String formatMillis(uint64 micros) {
+	return Common::String::format("%u.%u", (uint32)(micros / 1000), (uint32)(micros % 1000 / 100));
+}
+
+void diagFrame(uint32 dirtyPixels, uint64 flushTicks, uint64 updateTicks) {
+	if (!diagOn)
+		return;
+
+	const uint32 now = millisSinceStart();
+	if (firstFramePending) {
+		firstFramePending = false;
+		debug("diag: first frame at %ux%u, %u ms after the resolution change",
+		      firstFrameWidth, firstFrameHeight, now - resolutionChangeTime);
+	}
+
+	// The first interval starts with the first frame, each next one where the last ended
+	if (!statsRunning) {
+		statsRunning = true;
+		statsStart = now;
+		return;
+	}
+	statsFrames++;
+	statsDirtyPixels += dirtyPixels;
+	statsFlushTicks += flushTicks;
+	statsUpdateTicks += updateTicks;
+	if (flushTicks > statsFlushMax)
+		statsFlushMax = flushTicks;
+	if (updateTicks > statsUpdateMax)
+		statsUpdateMax = updateTicks;
+
+	const uint32 elapsed = now - statsStart;
+	if (elapsed < MAUSJAGD_DIAG_STATS_INTERVAL)
+		return;
+
+	// Frame rate with one decimal; "converted" is the area copied to the GPU texture
+	const uint32 fps10 = statsFrames * 10000 / elapsed;
+	debug("diag: %u frames in %u ms (%u.%u fps), converted avg %u px/frame, "
+	      "flush avg %s ms max %s ms, update avg %s ms max %s ms",
+	      statsFrames, elapsed, fps10 / 10, fps10 % 10,
+	      (uint32)(statsDirtyPixels / statsFrames),
+	      formatMillis(ticksToMicros(statsFlushTicks / statsFrames)).c_str(),
+	      formatMillis(ticksToMicros(statsFlushMax)).c_str(),
+	      formatMillis(ticksToMicros(statsUpdateTicks / statsFrames)).c_str(),
+	      formatMillis(ticksToMicros(statsUpdateMax)).c_str());
+
+	statsStart = now;
+	statsFrames = 0;
+	statsDirtyPixels = 0;
+	statsFlushTicks = 0;
+	statsFlushMax = 0;
+	statsUpdateTicks = 0;
+	statsUpdateMax = 0;
+}
+
+} // End of namespace Mausjagd
+
+#endif
diff --git a/backends/platform/3ds/mausjagd.h b/backends/platform/3ds/mausjagd.h
index f88e088722..8fb8de0ea6 100644
--- a/backends/platform/3ds/mausjagd.h
+++ b/backends/platform/3ds/mausjagd.h
@@ -50,4 +50,53 @@
 #define MAUSJAGD_GAME_ID "director:ggmd"
 #endif
 
+// Diagnostic mode. It is on when this file exists in the app folder on the
+// SD card or in the RomFS root (the SD card wins). The file holds extra
+// command line options for the game start, separated by spaces or line
+// breaks; lines starting with '#' are comments. Without options,
+// MAUSJAGD_DIAG_DEFAULT_ARGS is used.
+// In diagnostic mode, every log line carries the time since app start, and
+// the backend logs startup milestones, the first frame after each change of
+// the game resolution, and frame statistics every few seconds.
+#ifndef MAUSJAGD_DIAG_FILE
+#define MAUSJAGD_DIAG_FILE "diag.txt"
+#endif
+
+#ifndef MAUSJAGD_DIAG_DEFAULT_ARGS
+#define MAUSJAGD_DIAG_DEFAULT_ARGS "--debuglevel=1 --debugflags=loading"
+#endif
+
+// Interval of the frame statistics in milliseconds
+#ifndef MAUSJAGD_DIAG_STATS_INTERVAL
+#define MAUSJAGD_DIAG_STATS_INTERVAL 5000
+#endif
+
+#include "common/str-array.h"
+
+namespace Mausjagd {
+
+// Remembers the start time of the app. Call it first thing in main().
+void markAppStart();
+
+// Milliseconds since markAppStart()
+uint32 millisSinceStart();
+
+// Checks for the diag file and reads its options. Needs the file system,
+// so call it after g_system was created.
+void initDiag();
+
+bool diagEnabled();
+
+// Extra command line options from the diag file
+const Common::StringArray &diagArgs();
+
+// Called by the backend when the game resolution changes
+void diagResolutionChanged(uint width, uint height);
+
+// Called by the backend after each screen update with the area that was
+// converted for the GPU and the time spent converting and in the whole update
+void diagFrame(uint32 dirtyPixels, uint64 flushTicks, uint64 updateTicks);
+
+} // End of namespace Mausjagd
+
 #endif
