@@ -193,6 +193,10 @@ void OSystem_3DS::initSize(uint width, uint height,
 	debug("3ds initsize w:%d h:%d", width, height);
 #ifdef MAUSJAGD_PORT
 	Mausjagd::diagResolutionChanged(width, height);
+	// The first resolution set after engineInit() is the engine's; its next
