 	// Diagnostic mode: area converted for the GPU and time spent
 	const bool diag = Mausjagd::diagEnabled();
 	const u64 diagStart = diag ? svcGetSystemTick() : 0;
@@ -899,4 +913,79 @@ void OSystem_3DS::flushCursor() {
 	}
 }
 
+#ifdef MAUSJAGD_PORT
+// Startup screen of the standalone build. The detection and the engine
+// block the main thread for a few seconds without drawing, so the top
+// screen shows a title and a progress bar that advances with each phase.
+// Own design, no game graphics.
+
+void OSystem_3DS::engineInit() {
+	setStartupPhase(kStartupStartingGame);
+}
+
+void OSystem_3DS::setStartupPhase(StartupPhase phase) {
+	_startupPhase = phase;
+	if (phase == kStartupDone) {
+		_startupScreen.free();
+		return;
+	}
+
+	const int width = 400, height = 240;
+	if (!_startupScreen.getPixels())
+		_startupScreen.create(width, height, &DEFAULT_MODE);
+
+	const Graphics::PixelFormat &pf = _pfDefaultTexture;
+	const uint32 background = pf.RGBToColor(18, 24, 44);
+	const uint32 title = pf.RGBToColor(255, 255, 255);
+	const uint32 text = pf.RGBToColor(176, 186, 208);
+	const uint32 barFrame = pf.RGBToColor(176, 186, 208);
+	const uint32 barFill = pf.RGBToColor(240, 200, 80);
+
+	_startupScreen.fillRect(Common::Rect(width, height), background);
+
+	const Graphics::Font *bigFont = FontMan.getFontByUsage(Graphics::FontManager::kBigGUIFont);
+	const Graphics::Font *font = FontMan.getFontByUsage(Graphics::FontManager::kGUIFont);
+	if (bigFont)
+		bigFont->drawString(&_startupScreen, Common::U32String("M\xc3\xa4usejagd im Grandhotel"),
+		                    0, 76, width, title, Graphics::kTextAlignCenter);
+	if (font)
+		font->drawString(&_startupScreen, Common::U32String("3DS-Port mit ScummVM"),
+		                 0, 96, width, text, Graphics::kTextAlignCenter);
+
+	// Progress bar: one step per phase, the last step is the first frame of the game
+	const Common::Rect bar(80, 128, 320, 140);
+	_startupScreen.frameRect(bar, barFrame);
+	const int fillWidth = (bar.width() - 4) * phase / kStartupNumPhases;
+	if (fillWidth > 0)
+		_startupScreen.fillRect(Common::Rect(bar.left + 2, bar.top + 2, bar.left + 2 + fillWidth, bar.bottom - 2), barFill);
+
+	const char *status = phase == kStartupCheckingData ? "Spieldaten werden gepr\xc3\xbc" "ft ..." : "Spiel wird gestartet ...";
+	if (font)
+		font->drawString(&_startupScreen, Common::U32String(status),
+		                 0, 150, width, text, Graphics::kTextAlignCenter);
+
+	_startupScreen.setFilteringMode(false);
+	_startupScreen.markDirty();
+	renderStartupScreen();
+}
+
+void OSystem_3DS::renderStartupScreen() {
+	C3D_FrameBegin(0);
+		_startupScreen.transfer();
+	C3D_FrameEnd(0);
+
+	C3D_FrameBegin(0);
+		C3D_RenderTargetClear(_renderTargetTop, C3D_CLEAR_ALL, 0x00000000, 0);
+		C3D_FrameDrawOn(_renderTargetTop);
+		C3D_FVUnifMtx4x4(GPU_VERTEX_SHADER, _projectionLocation, &_projectionTop);
+		C3D_FVUnifMtx4x4(GPU_VERTEX_SHADER, _modelviewLocation, _startupScreen.getMatrix());
+		_startupScreen.render();
+
+		// The bottom screen stays black until the game starts
+		C3D_RenderTargetClear(_renderTargetBottom, C3D_CLEAR_ALL, 0x00000000, 0);
+		C3D_FrameDrawOn(_renderTargetBottom);
+	C3D_FrameEnd(0);
+}
+#endif
+
 } // namespace N3DS
