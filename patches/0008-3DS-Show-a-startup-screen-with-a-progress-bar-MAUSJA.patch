@@ -445,6 +449,16 @@ void OSystem_3DS::updateScreen() {
 	}
 
 #ifdef MAUSJAGD_PORT
+	// Keep the startup screen until the engine has set its resolution. A
+	// ScummVM dialog (e.g. an error message) ends it, so that it can be seen.
+	if (_startupPhase != kStartupDone) {
+		if (!_startupEngineReady && !_overlayVisible) {
+			renderStartupScreen();
+			return;
+		}
+		setStartupPhase(kStartupDone);
+	}
