 }
 
+void OSystem_3DS::setSecondaryScreen(const Graphics::Surface *image, const Common::Rect &marker) {
+	_secondaryMarker.free();
+	if (!image || !image->getPixels() || image->w <= 0 || image->h <= 0) {
+		_secondaryScreen.free();
+		return;
+	}
+
+	// Copy the picture into a top screen texture, converted and clipped to 400x240
+	const int width = MIN<int>(image->w, 400), height = MIN<int>(image->h, 240);
+	_secondaryScreen.create(width, height, &DEFAULT_MODE);
+	if (image->format == _secondaryScreen.format) {
+		_secondaryScreen.copyRectToSurface(*image, 0, 0, Common::Rect(width, height));
+	} else {
+		Graphics::Surface *converted = image->convertTo(_secondaryScreen.format);
+		_secondaryScreen.copyRectToSurface(*converted, 0, 0, Common::Rect(width, height));
+		converted->free();
+		delete converted;
+	}
+	_secondaryScreen.setPosition(0, 0);
+	_secondaryScreen.setFilteringMode(false);
+	_secondaryScreen.markDirty();
+
+	// Marker: a 2-pixel frame, transparent inside
+	Common::Rect frame = marker;
+	frame.clip(Common::Rect(width, height));
+	if (frame.width() > 4 && frame.height() > 4) {
+		const int w = frame.width(), h = frame.height();
+		const uint32 color = _pfDefaultTexture.ARGBToColor(255, 255, 220, 60);
+		_secondaryMarker.create(w, h, &DEFAULT_MODE);
+		_secondaryMarker.clear(0);
+		_secondaryMarker.fillRect(Common::Rect(0, 0, w, 2), color);
+		_secondaryMarker.fillRect(Common::Rect(0, h - 2, w, h), color);
+		_secondaryMarker.fillRect(Common::Rect(0, 0, 2, h), color);
+		_secondaryMarker.fillRect(Common::Rect(w - 2, 0, w, h), color);
+		_secondaryMarker.setPosition(frame.left, frame.top);
+		_secondaryMarker.setFilteringMode(false);
+		_secondaryMarker.markDirty();
+	}
+}
+
 void OSystem_3DS::renderStartupScreen() {
 	C3D_FrameBegin(0);
 		_startupScreen.transfer();
