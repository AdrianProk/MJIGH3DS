+#include "director/mausjagd-port.h"
+
+namespace Director {
+
+namespace {
+
+// Hotel overview of the game (movie GGMDMENU, frame "select"): a cutaway
+// picture of the hotel with all rooms and one sprite per room on top of it.
+// Line (sprite - 4) of field "roomlist" names the movie of that room.
+// Sprite 24 is the attic, shown once all rooms are done.
+const char *const kMapMovie = "GGMDMENU";
+const char *const kMapBitmap = "interfinalfordir0001";
+const char *const kRoomListField = "roomlist";
+const char *const kAtticMovie = "ATTIC";
+const char *const kMiceCaughtGlobal = "miceCaught";
+const int kFirstRoomSprite = 5;
+const int kNumRooms = 19;
+const int kAtticSprite = 24;
+const int kAttic = kNumRooms; // index of the attic in roomRects
+
+// The room sprites are the hot spots of the mouse detector and lie about 12
+// pixels lower than the room pictures. For the known hotel picture, the
+// marker uses the outlines of the room pictures instead, measured in the
+// picture (582x429, left/top inclusive, right/bottom exclusive).
+const int kKnownMapWidth = 582;
+const int kKnownMapHeight = 429;
+const struct {
+	const char *room;
+	int16 left, top, right, bottom;
+} kRoomPictures[] = {
+	{ "artist",   12,  81, 123, 161 }, { "farmer",  130,  81, 236, 161 },
+	{ "witches", 243,  81, 344, 161 }, { "plumber", 353,  81, 458, 161 },
+	{ "madsci",  467,  81, 572, 161 }, { "newlywed", 11, 166, 144, 247 },
+	{ "presbed", 152, 166, 286, 247 }, { "presliv", 295, 166, 427, 247 },
+	{ "ballroom", 436, 166, 570, 247 }, { "business", 11, 252, 109, 332 },
+	{ "playroom", 121, 252, 217, 332 }, { "slobs",   227, 252, 344, 332 },
+	{ "bathroom", 352, 252, 460, 332 }, { "exercise", 467, 252, 572, 332 },
+	{ "library",  11, 339, 117, 419 }, { "dining",  123, 339, 227, 419 },
+	{ "kitchen", 235, 339, 345, 419 }, { "bar",     352, 339, 459, 419 },
+	{ "snooker", 467, 339, 572, 419 }, { "attic",    12,  10, 570,  74 }
+};
+
+// Layout of the second screen: map in the middle, mouse counter on the left
+const int kScreenWidth = 400;
+const int kScreenHeight = 240;
+const int kPanelWidth = 40;
+const int kMaxMapWidth = kScreenWidth - 2 * kPanelWidth;
+
+struct SecondaryScreen {
+	bool haveMap = false;
+	bool failed = false;                   // map could not be used, don't try again
+	Graphics::Surface map;                 // hotel, scaled down to fit, RGBA
+	int pictureWidth = 0;                  // size of the original hotel picture
+	int pictureHeight = 0;
+	Common::Rect roomRects[kNumRooms + 1]; // coordinates in the original picture
+	Common::StringArray roomNames;         // movie names from field "roomlist"
+	Common::String debugRoom;              // test aid, see captureMap()
+	Common::String shownRoom;              // state of the last picture
+	int shownMice = -1;
+	bool shown = false;
+
+	~SecondaryScreen() { map.free(); }
+};
+
+SecondaryScreen g_screen;
+
+// "D:\GGMD\ARTIST.DXR" -> "ARTIST"
+Common::String baseName(const Common::String &movieName) {
+	uint start = 0;
+	for (uint i = 0; i < movieName.size(); i++) {
+		if (movieName[i] == '\\' || movieName[i] == '/' || movieName[i] == ':')
+			start = i + 1;
+	}
+	Common::String name(movieName.c_str() + start);
+	for (int i = (int)name.size() - 1; i >= 0; i--) {
+		if (name[i] == '.') {
+			name = Common::String(name.c_str(), (uint)i);
+			break;
+		}
+	}
+	name.trim();
+	return name;
+}
+
+// Lines of a field, empty lines included, as Lingo counts them
+Common::StringArray splitLines(const Common::String &text) {
+	Common::StringArray lines;
+	Common::String line;
+	for (uint i = 0; i < text.size(); i++) {
+		const char c = text[i];
+		if (c == '\r' || c == '\n') {
+			lines.push_back(line);
+			line.clear();
+			if (c == '\r' && i + 1 < text.size() && text[i + 1] == '\n')
+				i++;
+		} else {
+			line += c;
+		}
+	}
+	if (!line.empty())
+		lines.push_back(line);
+	return lines;
+}
+
+int miceCaught() {
+	if (!g_lingo || !g_lingo->_globalvars.contains(kMiceCaughtGlobal))
+		return 0;
+	const Datum &mice = g_lingo->_globalvars.getVal(kMiceCaughtGlobal);
+	if (mice.type == INT)
+		return mice.u.i;
+	if (mice.type == FLOAT)
+		return (int)mice.u.f;
+	return 0;
+}
+
+// Takes the hotel map, the room rectangles and the room names while the
+// overview is on stage. Returns false if the overview is not shown.
+bool captureMap(Movie *movie) {
+	Cast *cast = movie->getCast();
+	if (!cast)
+		return false;
+	CastMember *member = cast->getCastMemberByNameAndType(kMapBitmap, kCastBitmap);
+	if (!member || member->_type != kCastBitmap)
+		return false;
+
+	Score *score = movie->getScore();
+	Channel *mapChannel = nullptr;
+	for (uint i = 1; i < score->_channels.size(); i++) {
+		Channel *channel = score->_channels[i];
+		if (channel && channel->_visible && channel->_sprite && channel->_sprite->_cast == member) {
+			mapChannel = channel;
+			break;
+		}
+	}
+	if (!mapChannel)
+		return false;
+
+	const BitmapCastMember *bitmap = static_cast<BitmapCastMember *>(member);
+	const Picture *picture = bitmap->_picture;
+	const Common::Rect mapBox = mapChannel->getBbox();
+	if (!picture || picture->_surface.format.bytesPerPixel != 1 || !picture->_surface.getPixels() ||
+			picture->_surface.w < 2 || picture->_surface.h < 2 || mapBox.width() < 2 || mapBox.height() < 2) {
+		warning("mausjagd: hotel map '%s' has no usable 8-bit picture, second screen stays off", kMapBitmap);
+		g_screen.failed = true;
+		return false;
+	}
+
+	// Fit the hotel into the map area, keeping the aspect ratio, never enlarging
+	const Graphics::Surface &src = picture->_surface;
+	int width = kMaxMapWidth;
+	int height = src.h * kMaxMapWidth / src.w;
+	if (height > kScreenHeight) {
+		height = kScreenHeight;
+		width = src.w * kScreenHeight / src.h;
+	}
+	if (width > src.w || height > src.h) {
+		width = src.w;
+		height = src.h;
+	}
+	width = MAX(width, 1);
+	height = MAX(height, 1);
+
+	// The pixels refer to the bitmap's own palette; the engine remaps them to
+	// the stage palette only when drawing. Fall back to the stage palette.
+	const byte *palette = g_director->getPalette();
+	int colors = g_director->getPaletteColorCount();
+	const PaletteV4 *ownPalette = g_director->getPalette(bitmap->_clut);
+	if (ownPalette && ownPalette->palette && ownPalette->length > 0) {
+		palette = ownPalette->palette;
+		colors = ownPalette->length;
+	}
+
+	// Scale down, averaging all source pixels of each target pixel
+	const Graphics::PixelFormat format = Graphics::PixelFormat::createFormatRGBA32();
+	g_screen.map.free();
+	g_screen.map.create(width, height, format);
+	for (int y = 0; y < height; y++) {
+		const int sy0 = y * src.h / height;
+		const int sy1 = MAX(sy0 + 1, (y + 1) * src.h / height);
+		uint32 *dst = (uint32 *)g_screen.map.getBasePtr(0, y);
+		for (int x = 0; x < width; x++) {
+			const int sx0 = x * src.w / width;
+			const int sx1 = MAX(sx0 + 1, (x + 1) * src.w / width);
+			uint r = 0, g = 0, b = 0, n = 0;
+			for (int sy = sy0; sy < sy1 && sy < src.h; sy++) {
+				const byte *row = (const byte *)src.getBasePtr(0, sy);
+				for (int sx = sx0; sx < sx1 && sx < src.w; sx++) {
+					const int color = row[sx];
+					if (palette && color < colors) {
+						r += palette[color * 3];
+						g += palette[color * 3 + 1];
+						b += palette[color * 3 + 2];
+					}
+					n++;
+				}
+			}
+			dst[x] = n ? format.RGBToColor(r / n, g / n, b / n) : 0;
+		}
+	}
+	g_screen.pictureWidth = src.w;
+	g_screen.pictureHeight = src.h;
+
+	g_screen.roomNames.clear();
+	CastMember *field = cast->getCastMemberByNameAndType(kRoomListField, kCastText);
+	if (field && field->_type == kCastText) {
+		const Common::StringArray lines = splitLines(static_cast<TextCastMember *>(field)->getText().encode());
+		for (uint i = 0; i < lines.size() && i < (uint)kNumRooms; i++)
+			g_screen.roomNames.push_back(baseName(lines[i]));
+	}
+
+	// Room rectangles in picture coordinates: the measured room pictures for
+	// the known hotel picture, otherwise the hot spot sprites
+	const bool knownPicture = src.w == kKnownMapWidth && src.h == kKnownMapHeight;
+	for (int i = 0; i <= kNumRooms; i++) {
+		Common::Rect &rect = g_screen.roomRects[i];
+		rect = Common::Rect();
+		const Common::String name = (i == kAttic) ? Common::String(kAtticMovie) :
+			(i < (int)g_screen.roomNames.size() ? g_screen.roomNames[i] : Common::String());
+		if (knownPicture && !name.empty()) {
+			for (const auto &entry : kRoomPictures) {
+				if (name.equalsIgnoreCase(entry.room)) {
+					rect = Common::Rect(entry.left, entry.top, entry.right, entry.bottom);
+					break;
+				}
+			}
+		}
+		if (!rect.isEmpty())
+			continue;
+
+		const uint spriteNum = (i == kAttic) ? kAtticSprite : kFirstRoomSprite + i;
+		if (spriteNum < score->_channels.size()) {
+			Channel *channel = score->_channels[spriteNum];
+			if (channel && channel->_sprite && channel->_sprite->_castId.member != 0) {
+				// Stage coordinates relative to the hotel picture, in picture pixels
+				const Common::Rect box = channel->getBbox();
+				rect = Common::Rect((box.left - mapBox.left) * src.w / mapBox.width(),
+				                    (box.top - mapBox.top) * src.h / mapBox.height(),
+				                    (box.right - mapBox.left) * src.w / mapBox.width(),
+				                    (box.bottom - mapBox.top) * src.h / mapBox.height());
+				rect.clip(Common::Rect(src.w, src.h));
+			}
+		}
+	}
+
+	// Test aid: pretend to be in this room ("mausjagd_debug_room" in scummvm.ini)
+	if (ConfMan.hasKey("mausjagd_debug_room"))
+		g_screen.debugRoom = ConfMan.get("mausjagd_debug_room");
+
+	debug(1, "mausjagd: hotel map %dx%d at %d,%d-%d,%d on stage, scaled to %dx%d, palette %s (%s), %d room names",
+	      src.w, src.h, mapBox.left, mapBox.top, mapBox.right, mapBox.bottom, width, height,
+	      bitmap->_clut.asString().c_str(), palette == g_director->getPalette() ? "stage" : "own",
+	      (int)g_screen.roomNames.size());
+	for (int i = 0; i <= kNumRooms; i++) {
+		const Common::Rect &r = g_screen.roomRects[i];
+		debug(1, "mausjagd: room %d '%s' at %d,%d-%d,%d", i,
+		      i < (int)g_screen.roomNames.size() ? g_screen.roomNames[i].c_str() : (i == kAttic ? kAtticMovie : ""),
+		      r.left, r.top, r.right, r.bottom);
+	}
+	return true;
+}
+
+// Index into roomRects for a movie name, -1 if it is no room on the map
+int findRoom(const Common::String &name) {
+	for (uint i = 0; i < g_screen.roomNames.size(); i++) {
+		if (!g_screen.roomNames[i].empty() && name.equalsIgnoreCase(g_screen.roomNames[i]))
+			return g_screen.roomRects[i].isEmpty() ? -1 : (int)i;
+	}
+	if (name.equalsIgnoreCase(kAtticMovie) && !g_screen.roomRects[kAttic].isEmpty())
+		return kAttic;
+	return -1;
+}
+
+void showScreen(int room, int mice) {
+	const Graphics::PixelFormat format = Graphics::PixelFormat::createFormatRGBA32();
+	Graphics::Surface screen;
+	screen.create(kScreenWidth, kScreenHeight, format);
+	screen.fillRect(Common::Rect(kScreenWidth, kScreenHeight), format.RGBToColor(18, 24, 44));
+
+	const int mapX = kPanelWidth + (kMaxMapWidth - g_screen.map.w) / 2;
+	const int mapY = (kScreenHeight - g_screen.map.h) / 2;
+	screen.copyRectToSurface(g_screen.map, mapX, mapY, Common::Rect(g_screen.map.w, g_screen.map.h));
+
+	const Graphics::Font *font = FontMan.getFontByUsage(Graphics::FontManager::kGUIFont);
+	const Graphics::Font *bigFont = FontMan.getFontByUsage(Graphics::FontManager::kBigGUIFont);
+	const uint32 textColor = format.RGBToColor(176, 186, 208);
+	const uint32 numberColor = format.RGBToColor(240, 200, 80);
+	if (font)
+		font->drawString(&screen, Common::U32String("M\xc3\xa4use"), 0, 92, kPanelWidth, textColor, Graphics::kTextAlignCenter);
+	if (bigFont)
+		bigFont->drawString(&screen, Common::U32String(Common::String::format("%d", mice)), 0, 108, kPanelWidth, numberColor, Graphics::kTextAlignCenter);
+	if (font)
+		font->drawString(&screen, Common::U32String(Common::String::format("von %d", kNumRooms)), 0, 126, kPanelWidth, textColor, Graphics::kTextAlignCenter);
+
+	// Marker around the room's picture, scaled like the map, with 1 pixel of space
+	Common::Rect marker;
+	const int pw = g_screen.pictureWidth, ph = g_screen.pictureHeight;
+	if (room >= 0 && pw > 0 && ph > 0) {
+		const Common::Rect &r = g_screen.roomRects[room];
+		marker = Common::Rect(mapX + r.left * g_screen.map.w / pw - 1, mapY + r.top * g_screen.map.h / ph - 1,
+		                      mapX + r.right * g_screen.map.w / pw + 1, mapY + r.bottom * g_screen.map.h / ph + 1);
+		marker.clip(Common::Rect(kScreenWidth, kScreenHeight));
+	}
+
+	debug(1, "mausjagd: second screen: room %d, %d mice, marker %d,%d-%d,%d", room, mice,
+	      marker.left, marker.top, marker.right, marker.bottom);
+	g_system->setSecondaryScreen(&screen, marker);
+	screen.free();
+}
+
+} // End of anonymous namespace
+
+void mausjagdSecondaryScreenTick() {
+	if (g_screen.failed)
+		return;
+	Movie *movie = g_director->getCurrentMovie();
+	if (!movie || !movie->getScore())
+		return;
+	const Common::String name = baseName(movie->getMacName());
+
+	if (!g_screen.haveMap) {
+		if (!name.equalsIgnoreCase(kMapMovie) || !captureMap(movie))
+			return;
+		g_screen.haveMap = true;
+	}
+
+	const Common::String room = g_screen.debugRoom.empty() ? name : g_screen.debugRoom;
+	const int mice = miceCaught();
+	if (g_screen.shown && room == g_screen.shownRoom && mice == g_screen.shownMice)
+		return;
+
+	g_screen.shown = true;
+	g_screen.shownRoom = room;
+	g_screen.shownMice = mice;
+	showScreen(findRoom(room), mice);
+}
+
+} // End of namespace Director
+
+#endif
